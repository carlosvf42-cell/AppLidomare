# ── Clerk Authentication ─────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Notion Integration ────────────────────────────────────────────────────────
# Get the token from https://www.notion.so/my-integrations
# Database IDs: open each DB in Notion → copy the ID from the URL
NOTION_TOKEN=ntn_...
NOTION_DB_EJERCICIO=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_DB_ACTIVACION=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_DB_WEBINARS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOTION_DB_PODCAST=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
